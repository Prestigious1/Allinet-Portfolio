# ════════════════════════════════════════════════════════════════════════════
# ALLINET OS PORTFOLIO — Environment Variables
# ════════════════════════════════════════════════════════════════════════════
# Copy this file to `.env.local` and fill in each value.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
# All other variables are server-side only.
# ════════════════════════════════════════════════════════════════════════════

# ── Supabase ─────────────────────────────────────────────────────────────────
# Used by: SupabaseStorageProvider
# Get these from: https://supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Payload CMS / Database ───────────────────────────────────────────────────
# Used by: PayloadDatabaseProvider
# DATABASE_URL must be a PostgreSQL connection string (Supabase Postgres works).
# PAYLOAD_SECRET must be a long, random string (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATABASE_URL=postgresql://username:password@host:5432/database
PAYLOAD_SECRET=replace-with-a-32-char-random-secret
NEXT_PUBLIC_API_URL=http://localhost:3000

# ── AION AI Assistant ────────────────────────────────────────────────────────
# Primary provider: OpenRouter (gives access to 100+ models with one key)
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key

# Optional: Direct OpenAI fallback
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# Optional: Override provider/model/temperature (also configurable in CMS Admin → AI Settings)
# AI_PROVIDER=openrouter
# AI_MODEL=google/gemini-2.5-flash
# AI_TEMPERATURE=0.7

# ── Rate Limiting — Upstash Redis ─────────────────────────────────────────────
# For production: replaces the in-memory rate limiter with Redis-backed limiter
# that persists across serverless cold starts and multiple instances.
# Get free tier from: https://console.upstash.com → Redis → Create Database
# Select "REST API" tab for the credentials below.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ── Email — Resend ───────────────────────────────────────────────────────────
# Used by: LiveEmailProvider → /api/email route
# Get your key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# ── Analytics — Vercel Analytics ────────────────────────────────────────────
# Vercel Analytics is injected automatically by the Vercel platform in
# production. No extra configuration is required for basic event tracking.
# This ID is only needed if you self-host the analytics endpoint.
NEXT_PUBLIC_ANALYTICS_ID=your-vercel-analytics-id

# ── GitHub ───────────────────────────────────────────────────────────────────
# Used by: HybridGitHubProvider → /api/github route (server-side fetch)
# Create a Personal Access Token with repo:read scope at:
#   https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_github_personal_access_token
NEXT_PUBLIC_GITHUB_USERNAME=your-github-username
